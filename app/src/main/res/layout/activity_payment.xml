<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:text="💳 Thibitisha Malipo" android:textColor="@color/accent"
            android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Namba ya Kampuni">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCompany"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="650880" android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Kumbukumbu Namba" android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRef"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Namba ya Mteja (hiari)" android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="phone"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✅ Thibitisha" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/tvPayResult" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/text" android:paddingTop="12dp"/>
    </LinearLayout>
</ScrollView>
