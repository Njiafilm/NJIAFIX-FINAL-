<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:text="🛠️ Software Tools" android:textColor="@color/primary"
            android:textSize="20sp" android:textStyle="bold" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="8dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnAdb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ADB + Fastboot"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOdin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Odin (Samsung zote)"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SP Flash (MTK)"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mi Flash (Xiaomi)"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMiracle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Miracle / Thunder"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnUmt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="UMT / Chimera"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSamfw" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SamFw"/>

        <TextView android:text="Server (Termux)" android:textColor="@color/accent" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnStartServer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🟢 WASHA SERVER" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnServerStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🔎 HALI YA SERVER" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvTermuxStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/accent" android:paddingTop="6dp" android:textSize="12sp"/>

        <TextView android:text="Amri ADB (halisi, kupitia server)" android:textColor="@color/accent" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdbDevices" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="devices" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdbReboot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="reboot" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdbFastboot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="fastboot" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdbRecovery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="recovery" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdbInfo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ℹ️ info" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdbDiagnose" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🔍 chunguza" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFastbootDevices" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="fastboot devices" android:textSize="11sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnTermuxClearLock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🔓 Clear Screen Lock (Termux)" android:textSize="12sp" android:layout_marginTop="12dp"/>

        <TextView android:id="@+id/tvToolGuide" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/text" android:paddingTop="12dp" android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
